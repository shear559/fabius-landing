{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/build-study",
      "destination": "/#trials",
      "permanent": true
    },
    {
      "source": "/build-study.html",
      "destination": "/#trials",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://fabius-landing.vercel.app"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/rubik/(.*)\\.(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://fabius-landing.vercel.app"
        }
      ]
    },
    {
      "source": "/assets/vendor/katex-0.18.7/(.*)\\.(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://fabius-landing.vercel.app"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|mjs|woff2?|ttf|otf)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/((?!robots\\.txt$|sitemap\\.xml$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:[gG][pP][tT][bB][oO][tT]|[oO][aA][iI]\\-[sS][eE][aA][rR][cC][hH][bB][oO][tT]|[cC][hH][aA][tT][gG][pP][tT]\\-[uU][sS][eE][rR]|[cC][lL][aA][uU][dD][eE][bB][oO][tT]|[cC][lL][aA][uU][dD][eE]\\-[uU][sS][eE][rR]|[cC][lL][aA][uU][dD][eE]\\-[sS][eE][aA][rR][cC][hH][bB][oO][tT]|[aA][nN][tT][hH][rR][oO][pP][iI][cC]\\-[aA][iI]|[cC][cC][bB][oO][tT]|[pP][eE][rR][pP][lL][eE][xX][iI][tT][yY][bB][oO][tT]|[pP][eE][rR][pP][lL][eE][xX][iI][tT][yY]\\-[uU][sS][eE][rR]|[gG][oO][oO][gG][lL][eE]\\-[eE][xX][tT][eE][nN][dD][eE][dD]|[aA][pP][pP][lL][eE][bB][oO][tT]\\-[eE][xX][tT][eE][nN][dD][eE][dD]|[mM][eE][tT][aA]\\-[eE][xX][tT][eE][rR][nN][aA][lL][aA][gG][eE][nN][tT]|[mM][eE][tT][aA]\\-[eE][xX][tT][eE][rR][nN][aA][lL][fF][eE][tT][cC][hH][eE][rR]|[aA][mM][aA][zZ][oO][nN][bB][oO][tT]|[cC][oO][hH][eE][rR][eE]\\-[aA][iI]|[cC][oO][hH][eE][rR][eE]\\-[tT][rR][aA][iI][nN][iI][nN][gG]\\-[dD][aA][tT][aA]\\-[cC][rR][aA][wW][lL][eE][rR]|[dD][iI][fF][fF][bB][oO][tT]|[yY][oO][uU][bB][oO][tT]|[aA][iI]2[bB][oO][tT]|[aA][iI]2[bB][oO][tT]\\-[dD][oO][lL][mM][aA]|[tT][iI][mM][pP][iI][bB][oO][tT]|[pP][aA][nN][gG][aA][eE][aA]|[sS][cC][rR][aA][pP][yY]|[iI][mM][aA][gG][eE][sS][iI][fF][tT][bB][oO][tT]|[aA][hH][rR][eE][fF][sS][bB][oO][tT]|[sS][eE][mM][rR][uU][sS][hH][bB][oO][tT]|[dD][aA][tT][aA][fF][oO][rR][sS][eE][oO][bB][oO][tT]|[mM][jJ]12[bB][oO][tT]|[dD][oO][tT][bB][oO][tT]|[bB][yY][tT][eE][sS][pP][iI][dD][eE][rR]|[pP][eE][tT][aA][lL][bB][oO][tT]|[bB][lL][eE][xX][bB][oO][tT]|[sS][eE][rR][pP][sS][tT][aA][tT][bB][oO][tT]).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/(assets/.*|[^/]+\\.(css|js|mjs|svg|webmanifest))",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-site",
          "value": "cross-site"
        },
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "image|style|script|font|audio|video|track|object|embed|worker|sharedworker|serviceworker|manifest"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
