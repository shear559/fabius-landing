{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/assets/showcase-20260930-focused/math",
      "destination": "/assets/showcase-20260930-focused/math/preview",
      "permanent": false
    },
    {
      "source": "/assets/showcase-20260930-focused/swarm",
      "destination": "/assets/showcase-20260930-focused/swarm/preview",
      "permanent": false
    },
    {
      "source": "/assets/showcase-20260930-focused/memory",
      "destination": "/assets/showcase-20260930-focused/memory/preview",
      "permanent": false
    },
    {
      "source": "/assets/showcase-20260930-focused/code",
      "destination": "/assets/showcase-20260930-focused/code/preview",
      "permanent": false
    },
    {
      "source": "/build-study",
      "destination": "/#trials",
      "permanent": true
    },
    {
      "source": "/build-study.html",
      "destination": "/#trials",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://fabius-landing.vercel.app"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/rubik/(.*)\\.(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/vendor/katex-0.18.7/(.*)\\.(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/showcase-20260930-focused/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/showcase-20260930-focused/(math|swarm|memory|code)/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' https://fabius-landing.vercel.app; style-src 'self' https://fabius-landing.vercel.app 'unsafe-inline'; img-src 'self' https://fabius-landing.vercel.app data: blob:; font-src 'self' https://fabius-landing.vercel.app; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; sandbox allow-scripts allow-forms allow-downloads"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/gallery/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
